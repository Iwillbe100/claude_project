#!/usr/bin/env python3
"""처방 가지 시험지 — {TITLE}. **루프 {LOOP}.**

★ 이 파일은 `python scripts/new_detour.py` 가 복사해 쓰는 **틀**이다. 직접 쓰지 않는다.

**진단({DIAGNOSE})도 이 시험지로 하고, 합격(test_{KIND})도 이 시험지로 판정한다.**
같은 종이로 보므로 "진단은 문제라는데 시험은 합격"인 틈이 생기지 않는다.

보는 것 — `{TARGET}`
    (무엇이 보이면 불합격인가 — 한 줄씩. 실패 기록의 어느 줄에서 왔는지도 적는다)

지켜야 할 것
    - `travel_graph` 를 import 하지 않는다. 고치는 쪽이 채점표를 만들면 판정 독립이 무너진다
      (`check_graph_shape.py` 11번 검사가 본다).
    - 정상 결과물(인계본 · inject 없는 replay)에서는 **반드시 합격**해야 한다. 오탐이 있으면
      처방 가지가 매번 켜진다.
    - 먼저 **떨어지는 것을 본다.** 그 실패를 재현하고(`--inject {KIND}`) 이 시험지가 불합격을 내는지
      확인한 뒤에 고치는 법(`travel_graph/detours/{KIND}.py`)을 쓴다.

종료 코드  0 합격 · 2 불합격(증상 있음) · 1 깨짐
사용법     python scripts/detour_tests/test_{KIND}.py
"""
from __future__ import annotations

import re  # noqa: F401  — 글자 모양(예: 한글이 있나)을 볼 때 쓴다
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

#  시험지가 쓰는 도구는 전부 여기서 온다. 쓰지 않는 것이 있어도 지우지 않는다.
#    walk_strings(data)  모든 글 칸을 (이름표, 칸 이름, 값) 으로
#    assets(data)        모든 사진 자리를 (이름표, 사진 dict) 로
from _common import (  # noqa: E402, F401
    Result, assets, finish, main_for, read_html, read_research, walk_strings,
)


def run(root=None) -> Result:
    """처방 가지 시험지 — {TITLE}"""
    result = Result("처방 가지 시험지 — {TITLE} (test_{KIND})")
    {READ_VAR}, problem = {READER}(root)
    if {READ_VAR} is None:
        result.note_broken(problem)
        return result

    found = []
    # TODO(교육생): 증상이 보이면 한 줄씩 넣는다 —  found.append("어디: 무엇이 문제")
    #   루프 A 라면  walk_strings(data) · assets(data)  (_common.py) 가 칸을 돌아 준다.
    #   루프 B 라면  html 문자열을 읽는다 (test_image_spec.py 의 _Page 를 참고).

    finish(result, "{TITLE}", found)
    return result


if __name__ == "__main__":
    sys.exit(main_for(run))
