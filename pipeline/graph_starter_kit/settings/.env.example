# =============================================================================
# .env  --  LangSmith 연결 · 그래프 실행 설정  (settings/.env.example 과 같은 내용)
# -----------------------------------------------------------------------------
# 킷 배포본에는 이 내용의 .env 가 프로젝트 루트(graph_starter_kit/.env)에 이미 들어 있다.
# 교육생은 그 파일의 LANGSMITH_API_KEY 한 줄만 본인 키로 바꾸고
#   python settings/scripts/link_env.py        (마지막 줄 ENV_LINK: PASS)
# 를 돌린다. link_env.py 가 키를 검사하고 빠진 항목을 채운다(키는 마스킹해서만 보여 준다).
#
# 루트에 .env 가 없을 때만 settings/.env.example 을 복사해서 채운다 (킷 폴더에서):
#   Copy-Item settings\.env.example .env                 (Windows PowerShell)
#   cp settings/.env.example .env                        (macOS / Linux)
#
# .env 는 절대 git 에 커밋하지 않는다(.gitignore 에 있다). 키 값을 터미널에 그대로
# 출력하거나 채팅에 붙여 넣지 않는다.
# =============================================================================

# [필수] LangSmith API 키. https://smith.langchain.com > Settings > API Keys 에서 발급.
#        개인 키(lsv2_pt_...) 또는 서비스 키(lsv2_sk_...) 모두 가능하다.
LANGSMITH_API_KEY=lsv2_pt_여기에_본인_키를_붙여넣는다

# [필수] 트레이싱 스위치. true 여야 노드별 실행이 LangSmith 로 전송된다.
#        false 로 두면 그래프는 정상 동작하지만 추적 화면에 아무것도 뜨지 않는다.
LANGSMITH_TRACING=true

# [필수] 트레이스가 모일 프로젝트 이름. 교육생끼리 섞이지 않도록 본인 식별자를 붙인다.
#        예) langgraph-travel-course-hong
LANGSMITH_PROJECT=langgraph-travel-course

# [선택] 리전 엔드포인트. 비워 두면 미국 리전(https://api.smith.langchain.com)이 기본값.
#        EU 리전 계정이면 아래 주석을 해제한다.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# =============================================================================
# claude -p 호출 설정  --  조사(collect_*)와 정성 판정(quality)이 쓰는 값이다.
# -----------------------------------------------------------------------------
# 이 두 줄은 travel_graph/research.py 가 읽어 `claude -p` 명령줄에 그대로 붙인다.
#   GRAPH_CLAUDE_MODEL  -> --model
#   GRAPH_CLAUDE_EFFORT -> --effort
#
# 주의: 그래프 실행에서 `.env` 를 읽어 주는 것은 `langgraph dev` 다(langgraph.json 의
#       "env": ".env"). 값을 고쳤으면 **Studio 를 껐다 켜야** 반영된다.
#       `scripts/run_once.py` 는 `.env` 를 읽지 않지만, research.py 의 코드
#       기본값이 아래와 같게 맞춰져 있어 결과는 동일하다 (sonnet · medium · 600초).
#       단, run_once.py 는 LANGSMITH_* 도 읽지 않으므로 **터미널 실행은 트레이스가 남지 않는다.**
#       실제로 무엇이 적용됐는지는 LangSmith 트레이스의 `llm` run metadata 에서
#       `모델` · `에포트` 칸으로 확인한다.
# =============================================================================

# [선택] 호출 모델. 별칭(sonnet / opus / haiku) 또는 정식 이름(claude-sonnet-5).
#        실습 기본값은 sonnet — 조사 품질과 비용이 균형을 이루는 지점이다.
GRAPH_CLAUDE_MODEL=sonnet

# [선택] 사고 강도. low / medium / high / xhigh / max 다섯 개만 유효하다.
#        실습 기본값은 medium. 도시 3곳을 병렬로 부르고 정성 판정을 3회 더 돌기
#        때문에 high 이상은 GRAPH_CLAUDE_TIMEOUT(600초)을 넘겨 replay 로 떨어지기
#        쉽고, low 는 재수집이 부족한 칸을 잘 메우지 못한다.
#        빈 값이나 off 를 주면 옵션을 붙이지 않고 CLI 기본값에 맡긴다.
GRAPH_CLAUDE_EFFORT=medium

# [권장] `langgraph dev` 가 기동할 때 PyPI 와 비교해 띄우는 "새 버전이 있습니다 ·
#        End of Life · 지금 업그레이드하라(pip install -U langgraph-api)" 안내를 끈다.
#        이 킷은 dev 3종 세트를 lock 으로 함께 고정했으므로 **업그레이드하지 않는다**
#        (SETUP.md R4). 안내를 보고 하나만 올리면 Studio 가 깨질 수 있다.
LANGGRAPH_NO_VERSION_CHECK=true

# [선택] claude 실행 파일의 절대 경로. **보통은 적지 않는다 (주석 그대로 둔다).**
#
#        비워 두면 travel_graph/claude_cli.py 가 후보를 하나씩 **실제로 실행해 보고**
#        살아 있는 것을 고른다. Windows 에서 이 절차가 필요한 이유는, npm 이 같은 이름의
#        shim 을 여러 개 만들기 때문이다.
#
#            %APPDATA%\npm\claude       #!/bin/sh 로 시작하는 POSIX 스크립트 (실행 불가)
#            %APPDATA%\npm\claude.cmd   Windows 배치 shim
#            %APPDATA%\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe  진짜 바이너리
#
#        이름만으로는 어느 것이 실행 가능한지 알 수 없고, 어느 것이 잡히는지는
#        PATH 순서 · PATHEXT · 설치 방식에 따라 갈린다. 그래서 이름을 고르지 않고
#        실행해서 증명한다.
#
#        이 줄이 필요한 경우: 자동 탐색이 전부 실패했을 때(교육장 PATH 정책 등).
#        먼저 킷 폴더에서 아래를 돌려 무엇이 왜 탈락했는지 보고, 그래도 안 되면 주석을 푼다.
#
#            python -m travel_graph.claude_cli
#
#        참고: 위의 주의사항이 이 항목에도 그대로 적용된다 — 그래프 실행에서 `.env` 를
#        읽어 주는 것은 `langgraph dev` 뿐이다 (위 명령도 `.env` 를 읽지 않는다. 적은 값이
#        먹는지는 `python settings/scripts/verify_env.py` 의 C11 `실행 파일` 줄로 본다).
#        `scripts/run_once.py` 로 돌리면서 이 값이 꼭 필요하면 터미널에서 환경변수로 직접 준다.
#            $env:GRAPH_CLAUDE_BIN="C:\...\claude.exe"   (PowerShell)
#
# GRAPH_CLAUDE_BIN=C:\Users\<이름>\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe
